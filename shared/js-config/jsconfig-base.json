{
  "$schema": "https://json.schemastore.org/jsconfig",
  "compilerOptions": {
    "esModuleInterop": true,
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "target": "ES2022",
    "allowImportingTsExtensions": false,
    "checkJs": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitAny": false,
    "strict": false
  }
}
