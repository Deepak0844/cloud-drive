# =============================================================================
# .env.prod.example — Root-level production environment variables
# Copy to .env.prod and fill in values before running the prod stack.
#
# Usage: docker compose -p cloud-drive-prod \
#          -f docker-compose.yml -f docker-compose.prod.yml \
#          --env-file .env.prod up -d --build
#   OR:  make prod
# =============================================================================

# Hostname used in the nginx server_name directive, the HTTP redirect target,
# and the self-signed cert CN. Set to the machine's LAN hostname or IP.
SERVER_NAME=raspberrypi.local

# HSTS max-age in seconds.
# 31536000 (1 year) is correct for production with a stable cert.
# If the self-signed cert may be regenerated between rebuilds, use 300 until stable.
HSTS_MAX_AGE=31536000

# Host ports for the web container.
WEB_PORT=80
HTTPS_PORT=443

# Absolute path to NAS/USB storage on the host.
NAS_HOST_PATH=/Volumes/PenDrive/cloud-drive-storage
