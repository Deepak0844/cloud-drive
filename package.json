{
  "name": "cloud-drive",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "web:dev": "turbo run dev --filter=cloud-drive-web",
    "server:dev": "turbo run dev --filter=cloud-drive-server",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,md}\""
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
