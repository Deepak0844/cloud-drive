{
  "name": "cloud-drive",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "web:dev": "turbo run dev --filter=cloud-drive-web",
    "server:dev": "turbo run dev --filter=cloud-drive-server",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:android-prebuild": "npm run android-prebuild -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:ios-prebuild": "npm run ios-prebuild -w apps/mobile",
    "mobile:web": "npm run web -w apps/mobile",
    "mobile:prebuild:android": "npm run prebuild:android -w apps/mobile",
    "mobile:prebuild:ios": "npm run prebuild:ios -w apps/mobile",
    "mobile:db:generate": "npm run db:generate -w apps/mobile",
    "mobile:db:studio": "npm run db:studio -w apps/mobile",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{js,jsx,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,md}\"",
    "type-check": "turbo run type-check",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "turbo": "^2.8.1"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "shared/*"
  ]
}
