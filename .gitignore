# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
node_modules
.pnp
.pnp.js

# Environment files — never commit real secrets
.env
.env.local
.env.development
.env.production
.env.development.local
.env.test.local
.env.production.local
# env/ subfolder secrets
apps/server/env/.env
apps/server/env/.env.development
apps/server/env/.env.production
# Allow example/template files
!*.env.example
!.env.example
!apps/server/env/.env.example
!apps/server/env/.env.development.example
!apps/server/env/.env.production.example

# Testing
coverage

# Turbo
.turbo

# Build Outputs
build
dist


# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# User storage
apps/server/storage/*

# Misc
.DS_Store
*.pem

package-lock.json

# Gemini
.gemini

.agent

.github