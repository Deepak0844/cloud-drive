# =============================================================================
# .env.staging.example — Root-level staging environment variables
# Copy to .env.staging and fill in values before running the staging stack.
#
# Usage: docker compose -p cloud-drive-staging \
#          -f docker-compose.yml -f docker-compose.staging.yml \
#          --env-file .env.staging up -d --build
#   OR:  make staging
# =============================================================================

# Hostname used in the nginx server_name directive, the HTTP redirect target,
# and the self-signed cert CN. Set to the machine's actual hostname or IP
# when accessing remotely (e.g. raspberrypi.local, 192.168.1.42).
SERVER_NAME=localhost

# HSTS max-age in seconds.
# 300 (5 min) is safe when the self-signed cert may be regenerated on rebuild.
# Raise to 31536000 only after switching to a stable Let's Encrypt cert.
HSTS_MAX_AGE=300

# Host ports for the web container.
# Use non-standard ports (8080/8443) to coexist with prod on the same machine.
WEB_PORT=8080
HTTPS_PORT=8443

# Host port for the staging MongoDB container.
# 27019 avoids conflict with the dev container (27018) on the same machine.
MONGO_PORT=27019

# Absolute or relative path to staging storage on the host.
NAS_HOST_PATH=./data/staging-storage
