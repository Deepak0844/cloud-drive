# =============================================================================
# .env.dev.example — Root-level dev environment variables
# Copy to .env.dev and fill in values before running the dev stack.
#
# Usage: docker compose -f docker-compose.yml -f docker-compose.dev.yml \
#          --env-file .env.dev up -d
#   OR:  make dev
# =============================================================================

# Absolute or relative path to the local storage directory on the host.
# Docker Compose mounts this at /storage inside the server container.
# The :? guard in docker-compose.dev.yml fails fast if this is unset or blank.
NAS_HOST_PATH=./data/storage

# Basic-auth credentials for mongo-express (http://localhost:8081).
# The :? guard enforces that MONGO_EXPRESS_PASS is set and non-empty.
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASS=changeme
