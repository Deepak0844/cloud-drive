# ── Dependencies ───────────────────────────────────────────────────────────────
node_modules/
.turbo/
.git/

# ── Build outputs ──────────────────────────────────────────────────────────────
apps/web/dist/
apps/web/.turbo/
apps/server/.turbo/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.*.example

# ── Test artifacts ─────────────────────────────────────────────────────────────
test-storage/
__tests__/
*.test.js
jest.config.js
coverage/

# ── Dev tools ──────────────────────────────────────────────────────────────────
.husky/
.vscode/
.prettierrc
.prettierignore
eslint.config.*
.npmrc

# ── OS files ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Misc ───────────────────────────────────────────────────────────────────────
*.md
*.resolved
*.log
*.postman_collection.json

# ── Local dev storage ──────────────────────────────────────────────────────────
# Excludes the local NAS bind-mount directory used in dev (NAS_HOST_PATH=./data/storage).
# Without this, every docker build sends all uploaded files to the Docker daemon,
# making builds progressively slower as storage grows.
data/
