{
  "expo": {
    "name": "cloud-drive",
    "slug": "cloud-drive",
    "scheme": "clouddrive",
    "version": "0.0.1",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/splash-icon.png",
    "android": {
      "package": "com.clouddrive.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splash-icon.png",
        "backgroundColor": "#0f172a"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_DATA_SYNC",
        "RECEIVE_BOOT_COMPLETED",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.clouddrive.app",
      "appleTeamId": "G8JZV79B8A",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "fetch"],
        "NSSupportsLiveActivities": true,
        "NSPhotoLibraryUsageDescription": "Used to back up your photos to cloud-drive.",
        "NSPhotoLibraryAddUsageDescription": "Used to save files from cloud-drive to your photo library."
      }
    },
    "plugins": [
      "@bacons/apple-targets",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      "expo-sqlite",
      "expo-notifications",
      "expo-media-library",
      "expo-system-ui",
      "expo-secure-store",
      "expo-image",
      "expo-video",
      "expo-audio",
      "./modules/background-chunk-transfer/app.plugin.js"
    ]
  }
}
