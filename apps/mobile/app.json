{
  "expo": {
    "name": "cloud-drive",
    "slug": "cloud-drive",
    "scheme": "clouddrive",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.clouddrive.app",
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification", "fetch"],
        "NSPhotoLibraryUsageDescription": "cloud-drive needs access to your photo library to back up your photos.",
        "NSPhotoLibraryAddUsageDescription": "cloud-drive needs permission to save photos to your library."
      }
    },
    "android": {
      "package": "com.clouddrive.app",
      "permissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO"
      ]
    },
    "plugins": [
      "expo-notifications",
      "expo-media-library",
      "expo-sqlite",
      "expo-secure-store",
      "expo-image",
      "expo-sharing"
    ]
  }
}
