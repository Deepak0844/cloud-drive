{
  "name": "mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android-prebuild": "npm run prebuild:android && expo run:android",
    "android-release": "npm run prebuild:android && expo run:android --variant release",
    "android-build:apk": "cd android && ./gradlew assembleRelease",
    "android-build:aab": "cd android && ./gradlew bundleRelease",
    "ios": "expo run:ios",
    "ios-prebuild": "npm run prebuild:ios && expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild -p android",
    "prebuild:ios": "expo prebuild -p ios",
    "lint": "expo lint",
    "db:generate": "drizzle-kit generate --name initial",
    "db:studio": "drizzle-kit studio --config=drizzle.studio.config.js"
  },
  "dependencies": {
    "@react-navigation/native": "^7.3.3",
    "@react-navigation/native-stack": "^7.17.5",
    "@reduxjs/toolkit": "^2.6.1",
    "drizzle-orm": "^0.45.2",
    "expo": "~56.0.12",
    "expo-build-properties": "~56.0.19",
    "expo-dev-client": "~56.0.20",
    "expo-media-library": "~56.0.7",
    "expo-notifications": "~56.0.18",
    "expo-splash-screen": "~56.0.10",
    "expo-sqlite": "~56.0.5",
    "expo-status-bar": "~56.0.4",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0",
    "redux": "^5.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/metro-config": "0.86.0",
    "babel-plugin-inline-import": "^3.0.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~56.0.15",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~56.0.4",
    "expo-drizzle-studio-plugin": "^0.2.1",
    "react-native-svg-transformer": "^1.5.1",
    "tailwindcss": "^3.4.17"
  },
  "engines": {
    "node": ">=18"
  }
}
