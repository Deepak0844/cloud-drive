PORT=9001
MONGODB_URI=mongodb://localhost:27017/cloud-drive
JWT_SECRET=replace-with-strong-secret
STORAGE_ENCRYPTION_KEY=replace-with-64-char-hex-string-0000000000000000000000000
JWT_EXPIRES_IN=7d

SMTP_HOST=
SMTP_PORT=
SMTP_EMAIL=
SMTP_PASSWORD=

FROM_NAME=Cloud Drive
FROM_EMAIL=noreply@cloud-drive.com

DEFAULT_QUOTA_BYTES=10000000000
NAS_STORAGE_PATH=./storage
APP_BASE_URL=http://localhost:9001

NODE_ENV=development
LOG_LEVEL=info
TRASH_EXPIRY_DAYS=30
CLEANUP_INTERVAL_HOURS=1
TEMP_UPLOAD_EXPIRY_HOURS=24

# Comma-separated origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:9001
