meta {
  name: Reset Password
  type: http
  seq: 5
}

post {
  url: {{base_url}}/auth/reset-password
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "token": "RESET_TOKEN_HERE",
      "password": "newPassword123"
  }
}

settings {
  encodeUrl: true
}
