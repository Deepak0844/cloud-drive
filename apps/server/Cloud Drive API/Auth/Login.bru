meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{base_url}}/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
      "email": "user@example.com",
      "password": "passw0rd"
  }
}

script:post-response {
  var jsonData = res.getBody();
  if (jsonData.success && jsonData.data && jsonData.data.token) {
      bru.setVar("authToken", jsonData.data.token);
      console.log("✅ authToken set — all subsequent requests will use Bearer auth");
  } else {
      console.log("❌ Login failed or no token in response");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
