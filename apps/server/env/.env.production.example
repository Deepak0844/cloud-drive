# apps/server/.env.production
# Used by docker-compose.yml (production)
# Copy to .env.production and fill in real values — DO NOT commit this file

PORT=9000
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>?appName=<appname>
JWT_SECRET=<strong-production-secret-min-32-chars>
JWT_EXPIRES_IN=7d
NODE_ENV=production
LOG_LEVEL=info

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=<your-email>
SMTP_PASSWORD=<your-app-password>
FROM_NAME=Cloud Drive
FROM_EMAIL=noreply@cloud-drive.com

# Storage (mapped to /storage volume in Docker via NAS_HOST_PATH)
NAS_STORAGE_PATH=/storage
STORAGE_ENCRYPTION_KEY=<64-char-hex-string>

DEFAULT_QUOTA_BYTES=10000000000
APP_BASE_URL=https://<your-domain>
ALLOWED_ORIGINS=https://<your-domain>

TRASH_EXPIRY_DAYS=30
CLEANUP_INTERVAL_HOURS=1
TEMP_UPLOAD_EXPIRY_HOURS=24
