# =============================================================================
# apps/server/env/.env.staging.example — Staging server environment variables
# Copy to apps/server/env/.env.staging and fill in before running staging stack.
# =============================================================================

PORT=9000

# MongoDB URI — points to the staging mongo container (service name: mongo).
# To use a MongoDB Atlas staging cluster instead, replace with the Atlas URI.
MONGODB_URI=mongodb://mongo:27017/cloud-drive-staging

# JWT secrets — generate each with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_64_byte_hex_string
JWT_REFRESH_SECRET=replace_with_64_byte_hex_string

# Email (Nodemailer) — required for account verification flows.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Expo push notifications — leave blank to disable in staging.
EXPO_ACCESS_TOKEN=
