# apps/server/.env.development
# Used by docker-compose.dev.yml
# Copy this file and fill in real values — DO NOT commit this file

PORT=9000
# Overridden by docker-compose.dev.yml to point to local mongo container
# MONGODB_URI=mongodb://mongo:27017/cloud-drive
MONGODB_URI=mongodb://mongo:27017/cloud-drive
JWT_SECRET=replace-with-dev-secret-at-least-32-chars
JWT_EXPIRES_IN=7d
NODE_ENV=development
LOG_LEVEL=debug

# Email (optional for dev — leave blank to skip email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
FROM_NAME=Cloud Drive
FROM_EMAIL=noreply@cloud-drive.com

# Storage (mapped to /storage volume in Docker)
NAS_STORAGE_PATH=/storage
STORAGE_ENCRYPTION_KEY=1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

DEFAULT_QUOTA_BYTES=10000000000
APP_BASE_URL=http://localhost:9000
ALLOWED_ORIGINS=http://localhost:3000

TRASH_EXPIRY_DAYS=30
CLEANUP_INTERVAL_HOURS=1
TEMP_UPLOAD_EXPIRY_HOURS=24
