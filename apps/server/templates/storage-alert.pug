extends layout

block content
  h2(style="color: #ffffff; margin-top: 0; font-weight: 800; letter-spacing: -0.02em;") #{alertTitle}
  p Hello #{userName || 'User'},
  p #{alertMessage}
  
  .alert-box.alert-warning
    strong Quota Warning: 
    | You have used #{usedPercentage}% of your #{totalQuota} storage limit.
  
  p Consider deleting unnecessary files or upgrading your storage plan to avoid service interruption.
  
  a.button(href=actionUrl || '#') View Storage
