doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #030406;
        margin: 0;
        padding: 0;
        color: #f1f5f9;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #0b0e14;
        border-radius: 24px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: 0 40px 100px rgba(0,0,0,0.8);
      }
      .header {
        padding: 60px 20px;
        text-align: center;
        background: radial-gradient(circle at center, #1e1b4b 0%, #0b0e14 100%);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        position: relative;
      }
      .logo {
        width: 110px;
        height: 110px;
        margin-bottom: 24px;
        filter: drop-shadow(0 0 20px rgba(99, 102, 241, 0.4));
      }
      .app-name {
        font-size: 32px;
        font-weight: 900;
        letter-spacing: -0.04em;
        background: linear-gradient(to right, #ffffff, #a5b4fc);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        margin: 0;
        font-style: italic;
      }
      .content {
        padding: 56px 48px;
        line-height: 1.8;
        font-size: 16px;
        background: linear-gradient(180deg, rgba(255,255,255,0.02) 0%, rgba(255,255,255,0) 100%);
      }
      .footer {
        padding: 40px 20px;
        text-align: center;
        font-size: 13px;
        color: #64748b;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        background-color: #030406;
      }
      .button {
        display: inline-block;
        padding: 16px 36px;
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 12px;
        font-weight: 800;
        margin-top: 28px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        font-size: 14px;
        box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);
      }
      .alert-box {
        padding: 24px;
        border-radius: 16px;
        margin-top: 28px;
        font-size: 15px;
        font-weight: 600;
        backdrop-filter: blur(10px);
      }
      .alert-warning {
        background-color: rgba(245, 158, 11, 0.05);
        border: 1px solid rgba(245, 158, 11, 0.2);
        color: #fbbf24;
      }
      .alert-danger {
        background-color: rgba(239, 68, 68, 0.05);
        border: 1px solid rgba(239, 68, 68, 0.2);
        color: #f87171;
      }
      .alert-info {
        background-color: rgba(99, 102, 241, 0.05);
        border: 1px solid rgba(99, 102, 241, 0.2);
        color: #a5b4fc;
      }
      .alert-success {
        background-color: rgba(16, 185, 129, 0.05);
        border: 1px solid rgba(16, 185, 129, 0.2);
        color: #34d399;
      }
      .heading-text {
        color: #ffffff;
        margin-top: 0;
        font-weight: 800;
        letter-spacing: -0.02em;
      }
      .subtitle-text {
        font-size: 18px;
        color: #818cf8;
        font-weight: 600;
      }
      .session-box {
        margin: 30px 0;
        padding: 24px;
        background-color: rgba(255, 255, 255, 0.02);
        border-radius: 16px;
        border: 1px solid rgba(255, 255, 255, 0.05);
      }
      .section-label {
        color: #818cf8;
        font-size: 12px;
        text-transform: uppercase;
        margin-top: 0;
        margin-bottom: 20px;
        font-weight: 800;
        letter-spacing: 0.1em;
      }
      .label-cell {
        padding: 8px 0;
        color: #64748b;
        width: 120px;
        font-weight: 600;
      }
      .value-cell {
        padding: 8px 0;
        color: #f1f5f9;
        font-weight: 600;
      }
      .small-text {
        margin-top: 30px;
        font-size: 14px;
        color: #8b949e;
      }
      @media (prefers-color-scheme: light) {
        body {
          background-color: #f1f5f9 !important;
          color: #0f172a !important;
        }
        .container {
          background-color: #ffffff !important;
          border: 1px solid rgba(0, 0, 0, 0.08) !important;
          box-shadow: 0 40px 100px rgba(0, 0, 0, 0.08) !important;
        }
        .header {
          background: radial-gradient(circle at center, #eef2ff 0%, #f8fafc 100%) !important;
          border-bottom: 1px solid rgba(0, 0, 0, 0.06) !important;
        }
        .logo {
          filter: drop-shadow(0 0 20px rgba(99, 102, 241, 0.25)) !important;
        }
        .app-name {
          background: linear-gradient(to right, #4338ca, #7c3aed) !important;
          -webkit-background-clip: text !important;
          -webkit-text-fill-color: transparent !important;
        }
        .content {
          background: none !important;
        }
        .footer {
          border-top: 1px solid rgba(0, 0, 0, 0.06) !important;
          background-color: #f8fafc !important;
        }
        .button {
          box-shadow: 0 10px 30px rgba(99, 102, 241, 0.2) !important;
        }
        .alert-warning {
          background-color: rgba(245, 158, 11, 0.1) !important;
          border: 1px solid rgba(245, 158, 11, 0.35) !important;
          color: #92400e !important;
        }
        .alert-danger {
          background-color: rgba(239, 68, 68, 0.08) !important;
          border: 1px solid rgba(239, 68, 68, 0.3) !important;
          color: #b91c1c !important;
        }
        .alert-info {
          background-color: rgba(99, 102, 241, 0.08) !important;
          border: 1px solid rgba(99, 102, 241, 0.25) !important;
          color: #4338ca !important;
        }
        .alert-success {
          background-color: rgba(16, 185, 129, 0.08) !important;
          border: 1px solid rgba(16, 185, 129, 0.3) !important;
          color: #065f46 !important;
        }
        .heading-text {
          color: #0f172a !important;
        }
        .subtitle-text {
          color: #4f46e5 !important;
        }
        .session-box {
          background-color: rgba(0, 0, 0, 0.02) !important;
          border: 1px solid rgba(0, 0, 0, 0.08) !important;
        }
        .section-label {
          color: #4f46e5 !important;
        }
        .value-cell {
          color: #1e293b !important;
        }
        .small-text {
          color: #6b7280 !important;
        }
      }
  body
    .container
      .header
        img.logo(src="cid:logo" alt="Cloud Drive Logo")
        h1.app-name Cloud Drive
      .content
        block content
      .footer
        p &copy; 2026 Cloud Drive. All rights reserved.
        p You received this email because it's a critical security or system alert.
        p
          a(href="#" style="color: #58a6ff; text-decoration: none;") Notification Settings
