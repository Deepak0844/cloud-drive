doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    style.
      body {
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        background-color: #0b0e14;
        margin: 0;
        padding: 0;
        color: #e6edf3;
      }
      .container {
        max-width: 600px;
        margin: 40px auto;
        background-color: #0d1117;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #30363d;
        box-shadow: 0 20px 50px rgba(0,0,0,0.6);
      }
      .header {
        padding: 48px 20px;
        text-align: center;
        background: radial-gradient(circle at center, #161b22 0%, #0d1117 100%);
        border-bottom: 1px solid #30363d;
      }
      .logo {
        width: 100px;
        height: 100px;
        margin-bottom: 20px;
      }
      .app-name {
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -0.02em;
        color: #ffffff;
        margin: 0;
      }
      .content {
        padding: 48px 40px;
        line-height: 1.7;
        font-size: 16px;
      }
      .footer {
        padding: 32px 20px;
        text-align: center;
        font-size: 13px;
        color: #8b949e;
        border-top: 1px solid #30363d;
        background-color: #0b0e14;
      }
      .button {
        display: inline-block;
        padding: 14px 28px;
        background-color: #238636;
        color: #ffffff !important;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 700;
        margin-top: 24px;
        transition: background-color 0.2s;
      }
      .alert-box {
        padding: 20px;
        border-radius: 10px;
        margin-top: 24px;
        font-size: 15px;
        font-weight: 500;
      }
      .alert-warning {
        background-color: rgba(210, 153, 34, 0.1);
        border: 1px solid rgba(210, 153, 34, 0.4);
        color: #e3b341;
      }
      .alert-danger {
        background-color: rgba(248, 81, 73, 0.1);
        border: 1px solid rgba(248, 81, 73, 0.4);
        color: #ff7b72;
      }
  body
    .container
      .header
        img.logo(src="cid:logo" alt="Cloud Drive Logo")
        h1.app-name Cloud Drive
      .content
        block content
      .footer
        p &copy; 2026 Cloud Drive. All rights reserved.
        p You received this email because it's a critical security or system alert.
        p
          a(href="#" style="color: #58a6ff; text-decoration: none;") Notification Settings
